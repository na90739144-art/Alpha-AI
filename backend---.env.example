# کلید API گروک خودتان را اینجا بگذارید (هرگز این فایل را با مقدار واقعی commit نکنید)
GROQ_API_KEY=your_groq_api_key_here

# پورتی که بک‌اند روی آن اجرا می‌شود
PORT=3000

# آدرس دامنه فرانت‌اند شما (برای CORS) - چند مورد را با کاما جدا کنید
ALLOWED_ORIGINS=http://localhost:5500,https://your-frontend-domain.netlify.app
